@model IEnumerable<TurnovoFarmer.Models.ViewModels.ManageScheduleViewModel>

@{
    ViewData["Title"] = "Управление на графици";
    string StatusLabel(string status) => status switch
    {
        "collecting" => "Събира поръчки",
        "confirmed" => "Потвърден",
        "closed" => "Затворен",
        "completed" => "Завършен",
        "cancelled" => "Отменен",
        _ => status
    };
    string StatusClass(string status) => status switch
    {
        "collecting" => "bg-warning text-dark",
        "confirmed" => "bg-success",
        "closed" => "bg-primary",
        "completed" => "bg-secondary",
        "cancelled" => "bg-danger",
        _ => "bg-light text-dark"
    };
}

<div class="container py-4">
    <div class="row g-4">
        <div class="col-lg-3">
            <partial name="_FarmerNav" />
        </div>
        <div class="col-lg-9">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
                <div>
                    <h2 class="section-title mb-1">📅 Управление на графици</h2>
                    <p class="section-subtitle small mb-0">Добавяй, затваряй и управлявай дни за доставка</p>
                </div>
                <a asp-action="CreateSchedule" class="btn btn-organic">+ Добави нов ден за разнос</a>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success border-0 rounded-3 shadow-sm">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger border-0 rounded-3 shadow-sm">@TempData["Error"]</div>
            }

            @if (!Model.Any())
            {
                <div class="empty-state">
                    <div class="empty-icon">📅</div>
                    <h5 class="fw-bold">Няма графици</h5>
                    <p class="text-muted">Добавете първия ден за разнос.</p>
                    <a asp-action="CreateSchedule" class="btn btn-organic mt-2">+ Добави график</a>
                </div>
            }
            else
            {
                <div class="farmer-table">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Зона</th>
                                    <th>Дата</th>
                                    <th>Ден</th>
                                    <th>Тегло</th>
                                    <th>Поръчки</th>
                                    <th>Статус</th>
                                    <th class="text-end">Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in Model)
                                {
                                    var progressPercent = s.MinWeightRequired > 0
                                        ? Math.Min(100, (int)((s.CurrentTotalWeight / s.MinWeightRequired) * 100))
                                        : 0;

                                    <tr class="@(s.IsPast ? "opacity-75" : "")">
                                        <td>
                                            <span class="fw-semibold">@s.ZoneName</span>
                                            <br /><small class="text-muted">@s.ZoneDeliveryDay</small>
                                        </td>
                                        <td class="fw-semibold">@s.DeliveryDate.ToString("dd.MM.yyyy")</td>
                                        <td><span class="text-capitalize">@s.DayOfWeekBg</span></td>
                                        <td>
                                            <small class="text-muted">@s.CurrentTotalWeight.ToString("0.0") / @s.MinWeightRequired.ToString("0.0") кг</small>
                                            <div class="progress rounded-pill mt-1" style="height: 5px; width: 80px;">
                                                <div class="progress-bar bg-success" style="width: @progressPercent%;"></div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border">@s.OrderCount</span>
                                        </td>
                                        <td>
                                            <span class="badge @StatusClass(s.Status) rounded-pill">@StatusLabel(s.Status)</span>
                                        </td>
                                        <td class="text-end">
                                            <a asp-action="DeliverySheet" asp-route-id="@s.Id"
                                               class="btn btn-sm btn-organic-outline me-1" title="Шофьорски лист">📋 Лист</a>

                                            @if (s.CanClose)
                                            {
                                                <form asp-action="CloseSchedule" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@s.Id" />
                                                    <input type="hidden" name="status" value="confirmed" />
                                                    <button type="submit" class="btn btn-sm btn-success me-1"
                                                            onclick="return confirm('Потвърждавате ли графика? Нови поръчки няма да се приемат.');">
                                                        ✓ Потвърди
                                                    </button>
                                                </form>
                                                <form asp-action="CloseSchedule" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@s.Id" />
                                                    <input type="hidden" name="status" value="closed" />
                                                    <button type="submit" class="btn btn-sm btn-outline-primary me-1"
                                                            onclick="return confirm('Затваряте ли графика? Нови поръчки няма да се приемат.');">
                                                        🔒 Затвори
                                                    </button>
                                                </form>
                                            }

                                            @if (s.CanDelete && !s.IsPast)
                                            {
                                                <form asp-action="DeleteSchedule" asp-route-id="@s.Id" method="post" class="d-inline"
                                                      onsubmit="return confirm('@(s.OrderCount > 0 ? "Графикът има поръчки и ще бъде отменен. Продължавате ли?" : "Сигурни ли сте, че искате да изтриете този график?")');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        @(s.OrderCount > 0 ? "Отмени" : "Изтрий")
                                                    </button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
