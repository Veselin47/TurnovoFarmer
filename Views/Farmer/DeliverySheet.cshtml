@model TurnovoFarmer.Models.ViewModels.DriverDeliverySheetViewModel

@{
    ViewData["Title"] = $"Лист за доставка — {Model.DeliveryDate:dd.MM.yyyy}";
    var progressPercent = Model.MinWeightRequired > 0
        ? Math.Min(100, (int)((Model.CurrentTotalWeight / Model.MinWeightRequired) * 100))
        : 100;
    var ordersWithCoords = Model.Orders
        .Where(o => o.Latitude.HasValue && o.Longitude.HasValue)
        .ToList();
}

<div class="container py-4">
    <div class="row g-4">
        <div class="col-lg-3">
            <partial name="_FarmerNav" />
        </div>
        <div class="col-lg-9">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Фермерски панел</a></li>
            <li class="breadcrumb-item active">Лист за доставка</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">📋 Лист за шофьора</h2>
            <p class="text-muted mb-0">
                <strong>@Model.ZoneName</strong> — @Model.DeliveryDate.ToString("dd.MM.yyyy") (@Model.DeliveryDay)
            </p>
        </div>
        <span class="badge @(Model.Status == "confirmed" ? "bg-success" : "bg-warning text-dark") fs-6 px-3 py-2">
            @(Model.Status == "confirmed" ? "Потвърден курс" : "Събира поръчки")
        </span>
    </div>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 rounded-3 mb-4">
                <div class="card-header bg-success text-white rounded-top-3 py-3 border-0">
                    <h5 class="mb-0 fw-bold">🌾 Общо за берене / опаковане</h5>
                </div>
                <div class="card-body p-4">
                    @if (!Model.HarvestTotals.Any())
                    {
                        <p class="text-muted mb-0">Все още няма поръчки за този курс.</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var item in Model.HarvestTotals)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <span class="fw-semibold">@item.ProductName</span>
                                    <span class="badge bg-light text-dark fs-6">
                                        @item.TotalQuantity.ToString("0.##") @item.UnitType
                                    </span>
                                </li>
                            }
                        </ul>
                        <hr />
                        <p class="text-muted small mb-0">
                            Общо @Model.HarvestTotals.Count продукта за подготовка
                        </p>
                    }
                </div>
            </div>

            <div class="card shadow-sm border-0 rounded-3 bg-light p-4">
                <h6 class="fw-bold text-dark mb-2">🚛 Статус на курса</h6>
                <p class="text-muted small mb-2">
                    @Model.CurrentTotalWeight.ToString("0.0") кг от @Model.MinWeightRequired.ToString("0.0") кг минимум
                </p>
                <div class="progress rounded-pill mb-2" style="height: 10px;">
                    <div class="progress-bar bg-success" style="width: @progressPercent%;"></div>
                </div>
                <p class="mb-0 small fw-semibold @(Model.Status == "confirmed" ? "text-success" : "text-muted")">
                    @(Model.Status == "confirmed" ? "✅ Курсът е потвърден — камионът тръгва!" : "Очакват се още поръчки.")
                </p>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card shadow-sm border-0 rounded-3 mb-4">
                <div class="card-header bg-light rounded-top-3 py-3 border-0">
                    <h5 class="mb-0 fw-bold text-dark">👥 Поръчки по клиенти (@Model.Orders.Count)</h5>
                </div>
                <div class="card-body p-0">
                    @if (!Model.Orders.Any())
                    {
                        <p class="text-muted p-4 mb-0">Няма записани поръчки за този график.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>#</th>
                                        <th>Клиент</th>
                                        <th>Телефон</th>
                                        <th>Адрес</th>
                                        <th class="text-end">Сума</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in Model.Orders)
                                    {
                                        <tr>
                                            <td class="text-muted">@order.Id</td>
                                            <td class="fw-semibold">@order.CustomerName</td>
                                            <td>
                                                <a href="tel:@order.CustomerPhone" class="text-decoration-none">@order.CustomerPhone</a>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(order.DeliveryAddress))
                                                {
                                                    <span>@order.DeliveryAddress</span>
                                                }
                                                else if (order.Latitude.HasValue && order.Longitude.HasValue)
                                                {
                                                    <small class="text-muted">📍 Координати на картата</small>
                                                }
                                                else
                                                {
                                                    <small class="text-muted">—</small>
                                                }
                                            </td>
                                            <td class="text-end fw-bold text-success">@order.TotalAmount.ToString("0.00") лв.</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light">
                                    <tr>
                                        <td colspan="4" class="text-end fw-bold">Общ приход:</td>
                                        <td class="text-end fw-bold text-success">
                                            @Model.Orders.Sum(o => o.TotalAmount).ToString("0.00") лв.
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-primary text-white rounded-top-3 py-3 border-0">
                    <h5 class="mb-0 fw-bold">🗺️ Карта на маршрута</h5>
                </div>
                <div class="card-body p-3">
                    <div id="driverMap" style="height: 420px; width: 100%; border-radius: 8px;"></div>
                    @if (!ordersWithCoords.Any())
                    {
                        <p class="text-muted small mt-2 mb-0">Няма поръчки с GPS координати за показване на картата.</p>
                    }
                </div>
            </div>
        </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
    const orders = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        ordersWithCoords.Select(o => new {
            id = o.Id,
            name = o.CustomerName,
            phone = o.CustomerPhone,
            address = o.DeliveryAddress ?? "",
            lat = o.Latitude,
            lng = o.Longitude,
            total = o.TotalAmount
        })
    ));

    const defaultCenter = [43.0785, 25.6172];
    const map = L.map('driverMap').setView(defaultCenter, 13);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '© OpenStreetMap'
    }).addTo(map);

    if (orders.length > 0) {
        const bounds = [];

        orders.forEach(order => {
            const latLng = [order.lat, order.lng];
            bounds.push(latLng);

            const popup = `
                <strong>#${order.id} — ${order.name}</strong><br/>
                📞 ${order.phone}<br/>
                ${order.address ? order.address + '<br/>' : ''}
                💰 ${order.total.toFixed(2)} лв.`;

            L.marker(latLng).addTo(map).bindPopup(popup);
        });

        if (bounds.length === 1) {
            map.setView(bounds[0], 15);
        } else {
            map.fitBounds(bounds, { padding: [40, 40] });
        }
    }
</script>
