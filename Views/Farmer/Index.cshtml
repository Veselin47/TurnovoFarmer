@model IEnumerable<TurnovoFarmer.Models.ViewModels.FarmerDashboardScheduleViewModel>

@{
    ViewData["Title"] = "Фермерски панел";
}

<div class="container py-4">
    <div class="row g-4">
        <div class="col-lg-3">
            <partial name="_FarmerNav" />
        </div>
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="section-title mb-1">🚜 Фермерски панел</h2>
                    <p class="section-subtitle small mb-0">Активни и предстоящи курсове за доставка</p>
                </div>
                <span class="badge bg-success fs-6 px-3 py-2 rounded-pill">@Model.Count() графика</span>
            </div>

            @if (!Model.Any())
            {
                <div class="empty-state">
                    <div class="empty-icon">📅</div>
                    <h5 class="fw-bold">Няма предстоящи графици</h5>
                    <p class="text-muted mb-0">Новите курсове ще се появят тук автоматично.</p>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var schedule in Model)
                    {
                        var progressPercent = schedule.MinWeightRequired > 0
                            ? Math.Min(100, (int)((schedule.CurrentTotalWeight / schedule.MinWeightRequired) * 100))
                            : 100;
                        var statusBadge = schedule.Status switch
                        {
                            "confirmed" => ("bg-success", "Потвърден"),
                            "collecting" => ("bg-warning text-dark", "Събира поръчки"),
                            _ => ("bg-secondary", schedule.Status)
                        };

                        <div class="col-md-6">
                            <div class="organic-card p-4 h-100">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="fw-bold mb-0">@schedule.ZoneName</h5>
                                    <span class="badge @statusBadge.Item1 rounded-pill">@statusBadge.Item2</span>
                                </div>
                                <p class="text-success fw-semibold mb-2">
                                    📅 @schedule.DeliveryDate.ToString("dd.MM.yyyy")
                                    <span class="text-muted fw-normal">(@schedule.DeliveryDay)</span>
                                </p>
                                <div class="mb-3">
                                    <small class="text-muted">
                                        @schedule.CurrentTotalWeight.ToString("0.0") / @schedule.MinWeightRequired.ToString("0.0") кг
                                    </small>
                                    <div class="progress rounded-pill mt-1" style="height: 8px;">
                                        <div class="progress-bar bg-success" style="width: @progressPercent%;"></div>
                                    </div>
                                </div>
                                <div class="d-flex justify-content-between text-muted small mb-3">
                                    <span>📦 @schedule.OrderCount поръчки</span>
                                    <span class="fw-semibold text-success">@schedule.TotalRevenue.ToString("0.00") лв.</span>
                                </div>
                                <a asp-action="DeliverySheet" asp-route-id="@schedule.Id" class="btn btn-organic w-100">
                                    Лист за шофьора ➔
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
